# 新部署至少需要填写 FNOS_ROOT_KEY；其他配置均可使用默认值。
# 复制为 `.env` 后生成根密钥：
#
#   cp .env.example .env
#   openssl rand -hex 32
#
# 把生成的 64 位 hex 填入下面的 FNOS_ROOT_KEY。

# 固定正式版本可避免更新时自动跨版本；默认使用 latest。
APP_VERSION=latest

# Web 访问端口。
APP_PORT=5251

# 容器时区。
TZ=Asia/Shanghai

# 必填。唯一的 32-byte 根密钥；程序按用途派生 Flask 会话、账号、OpenList、通知等子密钥。
# 生成示例：openssl rand -hex 32
FNOS_ROOT_KEY=

# Transfer polling safety limits (seconds). These bound asynchronous waits
# across process restarts and move stuck operations to manual review.
TRANSFER_SOURCE_VISIBLE_TIMEOUT_SECONDS=1800
TRANSFER_NATIVE_WAIT_TIMEOUT_SECONDS=604800
TRANSFER_WAIT_TIMEOUT_SECONDS=10800
TRANSFER_CANCEL_TIMEOUT_SECONDS=3600

# 持久化目录。相对路径以 docker-compose.yml 所在目录为基准，也可以填写绝对路径。
# app.db、Worker 控制令牌和后台保存的业务配置都位于 APP_DATA_HOST_PATH。
APP_CONFIG_HOST_PATH=./config
APP_DATA_HOST_PATH=./data
APP_LOGS_HOST_PATH=./logs
RCLONE_CONFIG_HOST_PATH=./rclone/config
RCLONE_CACHE_HOST_PATH=./rclone/cache

# 搬运时可能暂存完整视频，建议放在大容量磁盘。
RCLONE_TEMP_HOST_PATH=./rclone/temp

# 跨 Provider 写入移动云或天翼时的共享中继目录，Web 与 Worker 均挂载到 /data/relay。
# rclone 只下载到这里，最终写入由目标 Provider 的原生 API uploader 完成。
FNOS_RELAY_HOST_PATH=./rclone/relay

# 可选。本地目录存储目标（local folder storage target）的宿主机目录，容器内映射到 /storage-targets。
# 必须是你预先挂载好的目录（例如 SMB/NFS 挂载点），绝不能指向 APP_DATA_HOST_PATH 等应用数据目录。
# 启用方式：先在本文件设置该变量，再取消 docker-compose.yml 中 fnos-rclone-worker 的对应挂载注释。
RCLONE_LOCAL_STORAGE_HOST_PATH=./rclone/local-storage

# 可选内置 PanSou 聚合搜索（fish2018/pansou），默认不启动。
# 启用：取消下面一行注释（或命令行加 --profile pansou），编排会多拉起一个 fnos-pansou 容器，
# 应用自动通过容器内网地址 http://pansou:8888 连接，开箱即用；不启用时可在后台
# "搜索与线路"填写自建外部 PanSou 地址。
# COMPOSE_PROFILES=pansou

# 内置 PanSou 的登录账号（仅容器内网可达，不对宿主机开放端口）；修改后需重新编排。
PANSOU_USERNAME=fnos-search
PANSOU_PASSWORD=fnos-search

# 可选。固定 PanSou 镜像版本，避免 latest 意外升级。
# PANSOU_IMAGE=ghcr.io/fish2018/pansou:latest

# 可选。PanSou 搜索缓存的宿主机目录。
# PANSOU_CACHE_HOST_PATH=./pansou/cache
