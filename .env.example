# =============================================================================
# 飞牛影视统一入库维护系统 - 可选 Docker 覆盖配置
# =============================================================================
#
# 直接执行 `docker compose up -d` 即可启动，不需要复制本文件。
# 只有需要修改默认端口、镜像版本、账号或宿主机目录时，才复制为 `.env`：
#
#   cp .env.example .env
#
# Docker Compose 会自动读取同目录的 `.env`。业务服务地址、Token、分类目录和通知
# 设置请在管理后台填写，不建议继续堆放在此文件中。

# ----------------------------------------------------------------------------
# 镜像与端口
# ----------------------------------------------------------------------------

# 正式镜像默认从 Docker Hub 拉取。国内镜像代理或私有仓库可覆盖完整仓库名。
APP_IMAGE=aichuguang/fnos-search

# 默认跟随 latest。生产环境可固定为发布版本，例如 1.2.0，便于控制升级时机。
APP_VERSION=latest

# Web 访问端口。默认地址：http://宿主机IP:5251
APP_PORT=5251

# 容器名称通常无需修改；同一宿主机运行多套实例时必须分别改名。
APP_CONTAINER_NAME=fnos-media-import
RCLONE_CONTAINER_NAME=rclone-server

# rclone 使用官方多架构镜像。
RCLONE_IMAGE=rclone/rclone:1.70.3

# ----------------------------------------------------------------------------
# 首次登录与基础运行
# ----------------------------------------------------------------------------

TZ=Asia/Shanghai
APP_ENV=production

# 默认账号为 admin / admin。首次登录后后台会持续提示修改密码；也可在这里预先覆盖。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# 正式容器默认启用严格安全校验。
SECURITY_STRICT=true

# 通常保持为空：应用签名密钥会自动随机生成并持久化到数据库。
# 已显式设置过该值的旧部署应继续保留原值，否则现有登录会话将失效。
APP_SECRET_KEY=

# 通常保持为空：容器会自动随机生成并保存到 data/.secrets/。
# 已显式设置过该值的旧部署应继续保留原值，否则已加密保存的 SMTP 等凭据无法解密。
NOTIFICATION_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# 持久化目录
# ----------------------------------------------------------------------------
#
# 默认使用 Compose 项目目录下的相对路径，Docker/NAS 面板会自动创建，不必提前选择目录。
# 需要把数据放到指定存储池时，再改成宿主机绝对路径。

APP_CONFIG_HOST_PATH=./config
APP_DATA_HOST_PATH=./data
APP_LOG_HOST_PATH=./logs
RCLONE_CONFIG_HOST_PATH=./rclone/config
RCLONE_TEMP_HOST_PATH=./rclone/temp
RCLONE_CACHE_HOST_PATH=./rclone/cache

# 临时目录可能存放大体积媒体文件；空间不足时优先只修改 RCLONE_TEMP_HOST_PATH。

# ----------------------------------------------------------------------------
# 权限与兼容性
# ----------------------------------------------------------------------------

# 容器业务进程默认使用非 root 用户 10001:10001；入口会修复挂载目录权限后立即降权。
APP_UID=10001
APP_GID=10001

# 标准 Docker 使用该 Socket。Rootless Docker 需改成实际路径，例如：
# /run/user/1000/docker.sock
DOCKER_SOCKET_HOST_PATH=/var/run/docker.sock

# ----------------------------------------------------------------------------
# 仅源码构建时使用
# ----------------------------------------------------------------------------
# 使用命令：
# docker compose -f docker-compose.yml -f compose.dev.yaml up -d --build

PYTHON_IMAGE=python:3.11-slim
DOCKER_CLI_IMAGE=docker:27-cli
PIP_INDEX_URL=https://pypi.org/simple
PIP_EXTRA_INDEX_URLS=https://mirrors.aliyun.com/pypi/simple https://mirrors.cloud.tencent.com/pypi/simple https://pypi.tuna.tsinghua.edu.cn/simple
